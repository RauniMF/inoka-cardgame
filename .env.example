# Database Configuration
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=playerdb
DB_USERNAME=CHANGE_ME_user
DB_PASSWORD=CHANGE_ME_secure_password_here

# MySQL Root Password (for Docker Compose MySQL service)
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_here

# Spring Boot Configuration
SERVER_PORT=8080

# JWT Configuration
# Generate a secure 64-character hex secret with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_64_char_hex_secret_with_openssl_rand_hex_32
JWT_EXPIRATION=86400000

# Game Configuration (Optional - uses defaults if not set)
GAME_INACTIVITY_TIMEOUT_MS=120000
GAME_CLEANUP_TIMEOUT_MS=600000
GAME_CLASH_PROCESSING_DELAY=1000
GAME_SCHEDULER_CHECK_INTERVAL_MS=500
GAME_ALL_PLAYERS_READY_DELAY=5000
GAME_INACTIVITY_KICK_TIMEOUT_MS=300000